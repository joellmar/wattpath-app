# =============================================================================
# Wattimizer – Variables de entorno de producción
# Copia este archivo como .env en el VPS y rellena TODOS los valores reales.
# NUNCA subas .env al repositorio (está en .gitignore).
# =============================================================================

# ── Base de datos (TimescaleDB) ───────────────────────────────────────────────
# Nombre de la base de datos (valor por defecto si se omite: wattimizer_db)
DB_NAME=wattimizer_db
# Usuario de PostgreSQL (valor por defecto si se omite: postgres)
DB_USER=postgres
# Contraseña de la base de datos — OBLIGATORIO, sin valor por defecto
DB_PASSWORD=

# ── Broker MQTT (Mosquitto) ───────────────────────────────────────────────────
# Usuario MQTT que usa el backend (debe existir en el password_file)
PROD_MQTT_USER=
# Contraseña MQTT del backend
PROD_MQTT_PASSWORD=

# ── Seguridad de la API ───────────────────────────────────────────────────────
# Clave secreta para firmar JWT (mín. 256 bits, alta entropía)
# Generar con: openssl rand -hex 32
PROD_JWT_SECRET=
# Clave maestra para el endpoint /api/v1/auth/register/admin
PROD_ADMIN_KEY=

# ── OAuth2: Google ────────────────────────────────────────────────────────────
# Registrar en https://console.cloud.google.com → APIs → Credenciales
# URI de redirección autorizada: https://wattimizer.com/login/oauth2/code/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── OAuth2: GitHub ────────────────────────────────────────────────────────────
# Registrar en https://github.com/settings/developers → OAuth Apps
# Authorization callback URL: https://wattimizer.com/login/oauth2/code/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── URLs de producción ────────────────────────────────────────────────────────
# URI a la que Spring redirige al frontend tras el login OAuth2
OAUTH2_FRONTEND_CALLBACK_URI=https://wattimizer.com/auth/oauth/callback

# Orígenes CORS permitidos por el backend (separados por coma, sin espacios)
APP_CORS_ALLOWED_ORIGINS=https://wattimizer.com,https://www.wattimizer.com
